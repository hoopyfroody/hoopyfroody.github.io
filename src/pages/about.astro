---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About">
	<h1>Hi!</h1>
	<div class="about-content">
		<p>
			This is just the place when I post my semi-coherent thoughts on things I'm learning.
			<br />
			<br />
			You can find me on <a href="https://bsky.app/profile/hoopyfrood.dev" class="social-link">Bluesky</a> and <a href="https://github.com/hoopyfroody" class="social-link">GitHub</a>.
		</p>
	</div>
</Layout>

<style>
	h1 {
		font-size: 2.5rem;
		margin-bottom: 2rem;
	}
	.about-content {
		background: var(--card-bg);
		padding: 2rem;
		border-radius: 8px;
		box-shadow: 0 2px 8px var(--card-shadow);
		line-height: 1.6;
		transition: background-color 0.3s ease, box-shadow 0.3s ease;
		font-size: 1.2rem;
	}
</style>